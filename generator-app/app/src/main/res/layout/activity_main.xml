<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="サイトをアプリ化"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ウェブサイトのURLを入れると、独立したアプリ（APK）をこの端末の中で生成します。"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="サイトURL" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="アプリ名" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例：Exampleサイト"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="パッケージ名（自動提案・編集可）" />

        <EditText
            android:id="@+id/pkgInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="app.webgen.example"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="権限（必要なサイトだけONにしてください）"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFの権限は生成アプリに含まれません。サイトがマイク等を使うときに実行時許可を求めます。"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/permMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="マイク（音声入力・通話など）" />

        <Switch
            android:id="@+id/permCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="カメラ（撮影・ビデオ通話など）" />

        <Switch
            android:id="@+id/permLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="位置情報" />

        <Switch
            android:id="@+id/permNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知（アプリ側の通知のみ。Webプッシュ通知は非対応）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/faviconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="サイトのアイコンを取得" />

            <Button
                android:id="@+id/pickButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="画像を選ぶ" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iconPreview"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="アイコンプレビュー" />

        <TextView
            android:id="@+id/iconStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="アイコン未選択（生成時にアプリ名の頭文字アイコンを自動生成します）"
            android:textSize="12sp" />

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="APKを生成" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="設定"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="更新チェック先 GitHub リポジトリ（owner/name）" />

        <EditText
            android:id="@+id/repoInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例: your-name/aprica（空欄で更新チェック無効）"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="設定すると、起動時と下のボタンで GitHub Releases の新版を確認します。新しいAPKも同じ署名キーで署名されているため、上書きインストールできます。生成したアプリへも、このリポジトリが更新フィードとして書き込まれます。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="更新を確認" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="現在のバージョン: アプリカ v1.2"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="生成履歴"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
