<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="設定"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="権限のデフォルト"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="作成画面の権限トグルの初期値です。ここでONにした権限が、作成画面を開いたときにあらかじめONになります（作成画面側でアプリごとに変更もできます）。"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/defMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="マイク（音声入力・通話など）" />

        <Switch
            android:id="@+id/defCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="カメラ（撮影・ビデオ通話など）" />

        <Switch
            android:id="@+id/defLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="位置情報" />

        <Switch
            android:id="@+id/defNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知（アプリ側の通知のみ。Webプッシュ通知は非対応）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="アプリカの更新"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="更新チェック先はアプリに組み込まれています（yorukaze-luru/aprica の GitHub Releases）。新しいAPKも同じ署名キーで署名されているため、上書きインストールできます。生成したアプリへも、このリポジトリが更新フィードとして書き込まれます。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="更新を確認" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="現在のバージョン: アプリカ"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="インストールと Play プロテクト"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="生成したアプリをインストールするとき、Google Play プロテクトの確認画面が出ることがあります。これはストア外から入れるアプリへの Android 標準の確認で、アプリ側で消したり範囲を変えたりすることはできません。確認画面では内容を確認して「そのままインストール」を選んでください。アプリカからインストールするときだけ、事前の案内ダイアログを表示します。Play プロテクト自体を止めたい場合は Play ストアのプロテクト設定から変更できますが、端末全体の保護が弱くなるためおすすめしません。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="作成画面に戻る" />
    </LinearLayout>
</ScrollView>
