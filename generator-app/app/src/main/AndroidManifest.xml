<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.webgen.generator">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Generated apps are launcher apps; declaring this intent makes
         them visible to getPackageInfo / getLaunchIntentForPackage
         (install state, launch button, silent-update checks). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="アプリカ"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WebGen">
        <activity
            android:name="app.webgen.generator.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.webgen.generator.SettingsActivity"
            android:exported="false" />
        <receiver
            android:name="app.webgen.generator.InstallResultReceiver"
            android:exported="false" />
        <!-- Serves generated APKs to the installer / share targets.
             Custom provider (no AndroidX FileProvider in this project);
             authority is bound to this app's own package. -->
        <provider
            android:name="app.webgen.generator.GenFileProvider"
            android:authorities="app.webgen.generator.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
